# Database Configuration
# Development: SQLite (file-based, no server needed)
DATABASE_URL=sqlite:./prisma/dev.db

# Production: PostgreSQL (uncomment and configure)
# DATABASE_URL=postgresql://user:password@localhost:5432/itsm_db?schema=public

# JWT Authentication
JWT_SECRET=change-this-in-production-use-crypto-random-32-bytes
JWT_EXPIRES_IN=24h

# Server Configuration
PORT=3000
HOST=0.0.0.0

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP Configuration (for email notifications)
# Development: Console fallback (logs to stdout instead of sending emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@itsm.local

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Session Management (if using sessions instead of pure JWT)
SESSION_SECRET=change-this-in-production
